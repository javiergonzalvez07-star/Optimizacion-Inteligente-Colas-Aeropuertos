# MODO DEMO
# ============================================================

ESCENARIOS_DEMO = [
    {
        "descripcion": "Mañana tranquila (baja ocupación)",
        "lectura": {"timestamp": "07:00", "checkin": 8,  "seguridad": 5,  "pasaportes": 3,  "embarque": 4},
    },
    {
        "descripcion": "Hora punta (alta ocupación)",
        "lectura": {"timestamp": "09:30", "checkin": 42, "seguridad": 35, "pasaportes": 18, "embarque": 25},
    },
    {
        "descripcion": "Saturación crítica",
        "lectura": {"timestamp": "10:15", "checkin": 80, "seguridad": 70, "pasaportes": 40, "embarque": 55},
    },
    {
        "descripcion": "Vuelta a la normalidad",
        "lectura": {"timestamp": "13:00", "checkin": 15, "seguridad": 12, "pasaportes": 6,  "embarque": 8},
    },
]

def modo_demo():
    print("\n🛫  MODO DEMO — Simulación de escenarios de aeropuerto\n")
    estado = EstadoSistema()

    for escenario in ESCENARIOS_DEMO:
        print(f"\n  ▶ Escenario: {escenario['descripcion']}")
        resultados = ejecutar_analisis(escenario["lectura"], estado)
        imprimir_informe(resultados, estado, escenario["lectura"]["timestamp"])
        input("  [Enter para siguiente escenario...]")


# ============================================================
# PUNTO DE ENTRADA
# ============================================================

def main():
    parser = argparse.ArgumentParser(description="Motor de colas M/M/c para aeropuerto")
    parser.add_argument("--csv",  type=str, help="Ruta al CSV generado por YOLO")
    parser.add_argument("--demo", action="store_true", help="Ejecutar con datos de demo")
    parser.add_argument("--output-csv", type=str, default="outputs/informe_colas.csv",
                        help="Ruta para guardar el informe de colas")
    args = parser.parse_args()

    estado = EstadoSistema()

    if args.demo:
        modo_demo()
        return

    if args.csv:
        lectura = leer_ultima_lectura_csv(args.csv)
        if lectura is None:
            return
        print(f"\n  Lectura cargada: {lectura}")
        resultados = ejecutar_analisis(lectura, estado)
        imprimir_informe(resultados, estado, lectura.get("timestamp", ""))
        guardar_informe_csv(resultados, args.output_csv)
        return

    parser.print_help()


if __name__ == "__main__":
    main()
